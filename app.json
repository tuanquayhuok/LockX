{
  "expo": {
    "name": "LockX",
    "slug": "lockx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "primaryColor": "#0A84FF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lockx.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "zalo",
          "fb",
          "fb-messenger",
          "instagram",
          "tiktok",
          "snssdk1180",
          "youtube",
          "tg",
          "whatsapp",
          "twitter",
          "spotify",
          "netflix",
          "googlechrome",
          "comgooglemaps",
          "momo",
          "vnpayqr",
          "shopeevn",
          "grab",
          "capcut",
          "discord",
          "threads",
          "pinterest",
          "linkedin",
          "reddit",
          "viber",
          "lazada",
          "tiki",
          "be",
          "baemin",
          "chatgpt",
          "canva"
        ],
        "NSFaceIDUsageDescription": "LockX sử dụng Face ID để xác thực và bảo vệ an toàn cho tài khoản và két sắt của bạn.",
        "NSMicrophoneUsageDescription": "LockX cần quyền micro để thực hiện cuộc gọi thoại bảo mật.",
        "NSCameraUsageDescription": "LockX cần quyền camera để chụp ảnh đại diện và quét mã.",
        "NSPhotoLibraryUsageDescription": "LockX cần quyền truy cập thư viện ảnh để đổi ảnh đại diện."
      }
    },
    "android": {
      "package": "com.lockx.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LockX sử dụng Face ID để xác thực và bảo vệ an toàn cho tài khoản và két sắt của bạn."
        }
      ]
    ]
  }
}
